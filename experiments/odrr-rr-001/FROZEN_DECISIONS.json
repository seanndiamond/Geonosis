  "blank_interval_seconds": 1.5,
  "ordinary_orientations_degrees": [0, 90, 180, 270],
  "primary_composite": "(coherence + grouping_change + (10 - mere_rotation))/3",
  "quality_control_gate": {
    "QC_ROT_STABLE": {
      "median_mere_rotation_min": 7,
      "median_grouping_change_max": 4
    },
    "QC_REARRANGED": {
      "median_grouping_change_min": 7
    },
    "failure_outcome": "INCONCLUSIVE — TASK/MEASUREMENT VALIDITY FAILURE"
  },
  "hard_boundary": "Observed rebinding does not by itself demonstrate intentional multi-orientation encoding.",
  "no_optional_stopping": true,
  "pilot_confirmatory_separation": true,
  "ethics_gate_required": true,
  "blind_key_hash_required_before_collection": true,
  "preregistration_required_before_collection": true,
  "outcome_classes": [
    "SURVIVED_AT_TESTED_SCOPE",
    "EQUIVALENT / DOWNGRADE",
    "CONTROL_ADVANTAGE / FALSIFIED_AT_TESTED_SCOPE",
    "INCONCLUSIVE"
  ]
}